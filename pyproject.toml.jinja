[project]
name = "{{project_name}}"
version = "0.1.0"
description = "{{project_description}}"
readme = "README.md"
authors = [{ name = "{{project_author}}" }]
requires-python = ">=3.14"
dependencies = []

[project.scripts]
{{project_name}} = "{{project_name}}:main"

[build-system]
requires = ["uv_build>=0.12.22,<0.13.0"]
build-backend = "uv_build"

[tool.coverage.report]
exclude_also = [
    "if __name__ == .__main__.:",
    ]
